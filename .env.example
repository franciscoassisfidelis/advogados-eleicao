# Variáveis de ambiente das Netlify Functions (definir em Netlify > Site
# configuration > Environment variables — NUNCA commitar um .env real).

# Supabase — Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE_SECRETA

# Integração opcional com Google Drive (deixe em branco para desativar)
# JSON completo da chave da conta de serviço do Google Cloud, em uma linha.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# ID da pasta do Drive (compartilhada com o e-mail da conta de serviço,
# permissão de Editor) — está no final da URL da pasta no Drive.
GOOGLE_DRIVE_FOLDER_ID=
